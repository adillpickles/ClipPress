{
  // The benchmark runs under Node but drives the renderer's size-limited planner, so it
  // is checked in its own project: Node's globals and lib, with the renderer's module
  // resolution so the shared modules type-check exactly as they do in the app.
  "extends": ["@tsconfig/strictest", "@tsconfig/node22/tsconfig.json"],
  "compilerOptions": {
    "noEmit": true,

    "module": "ESNext",
    "moduleResolution": "Bundler",

    // https://nodejs.org/api/typescript.html
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
  },
  "include": [
    "script/benchmarkSizeLimited.ts",
  ],
}
