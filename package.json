{
  "name": "clippress",
  "productName": "ClipPress",
  "description": "Fast clip editor for turning long recordings into clean, shareable clips",
  "version": "0.1.0-beta.6.7",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/adillpickles/ClipPress",
  "type": "module",
  "scripts": {
    "clean": "node -e \"for (const dir of ['dist', 'out', 'common-ts-dist', 'main-ts-dist', 'icon-build']) require('node:fs').rmSync(dir, { recursive: true, force: true })\"",
    "start": "electron-vite preview",
    "dev": "electron-vite dev -w",
    "download-ffmpeg-win32-x64": "mkdirp ffmpeg/win32-x64 && cd ffmpeg/win32-x64 && npx download-cli https://github.com/mifi/ffmpeg-builds/releases/download/9.0-2/ffmpeg-n9.0-latest-win64-gpl-shared-9.0.zip --out . --filename ffmpeg-ffprobe.zip && 7z x ffmpeg-ffprobe.zip && mkdirp lib && cd ffmpeg-n9.0-latest-win64-gpl-shared-9.0/bin && npx shx mv ffmpeg.exe ffprobe.exe *.dll ../../lib",
    "download-ffmpeg-win32-arm64": "mkdirp ffmpeg/win32-arm64 && cd ffmpeg/win32-arm64 && npx download-cli https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-n9.0-latest-winarm64-gpl-shared-9.0.zip --out . --filename ffmpeg-ffprobe.zip && 7z x ffmpeg-ffprobe.zip && mkdirp lib && cd ffmpeg-n9.0-latest-winarm64-gpl-shared-9.0/bin && npx shx mv ffmpeg.exe ffprobe.exe *.dll ../../lib",
    "build": "yarn generate-icon && node script/generateVersions.ts && electron-vite build",
    "tsc": "tsc --build",
    "test": "vitest",
    "lint": "eslint --ext .js,.ts,.jsx,.tsx,.mjs,.mts .",
    "check": "yarn tsc && yarn lint && yarn test run && yarn build && yarn check-licenses && yarn scan-i18n && yarn dedupe --check && yarn generate-docs",
    "pack-win": "yarn build && yarn generate-licenses && electron-builder --win --x64 --publish never && yarn check-package && node script/verifyUpdateArtifacts.ts",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "scan-i18n": "i18next-cli -c i18next.config.scan.ts extract",
    "generate-icon": "mkdirp icon-build && node script/generateIcon.ts",
    "generate-licenses": "node script/generateLicenses.ts",
    "generate-docs": "node script/generateDocs.ts",
    "check-licenses": "node script/checkLicenses.ts",
    "upload-artifacts": "node script/uploadArtifacts.ts",
    "benchmark-size-limited": "node script/benchmarkSizeLimited.ts",
    "check-package": "node script/checkPackagedApp.ts"
  },
  "author": {
    "name": "Adil Ahmed",
    "url": "https://github.com/adillpickles/ClipPress"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adillpickles/ClipPress.git"
  },
  "license": "GPL-2.0-only",
  "devDependencies": {
    "@actions/artifact": "^5.0.1",
    "@adamscybot/react-leaflet-component-marker": "^2.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-switch": "^1.2.6",
    "@tanstack/react-virtual": "3.13.18",
    "@tsconfig/node22": "^22.0.6",
    "@tsconfig/strictest": "^2.0.8",
    "@tsconfig/vite-react": "^7.0.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/color": "^4.2.0",
    "@types/css-modules": "^1.0.5",
    "@types/eslint": "^8.56.12",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.21",
    "@types/lodash": "^4.17.23",
    "@types/lodash.debounce": "^4.0.9",
    "@types/luxon": "^3.7.1",
    "@types/mime-types": "^3.0.1",
    "@types/morgan": "^1.9.10",
    "@types/node": "22.19.3",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/semver": "^7.7.1",
    "@types/smpte-timecode": "^1.2.5",
    "@types/yargs": "^17.0.35",
    "@types/yargs-parser": "^21.0.3",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^5.1.2",
    "canvas-confetti": "^1.9.4",
    "color": "^5.0.3",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "data-uri-to-buffer": "^8.0.0",
    "electron": "45.2.1",
    "electron-builder": "26.8.1",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-config-mifi": "^0.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unicorn": "56.0.1",
    "fast-xml-parser": "^5.4.1",
    "i18next-cli": "^1.34.1",
    "icon-gen": "^5.0.0",
    "immer": "^11.1.3",
    "ky": "^1.14.2",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.23",
    "luxon": "^3.7.2",
    "mkdirp": "^3.0.1",
    "motion": "^12.24.7",
    "nanoid": "^5.1.6",
    "p-map": "^7.0.4",
    "p-retry": "^7.1.1",
    "pretty-bytes": "^7.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.1",
    "react-icons": "^5.5.0",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "react-use": "^17.6.0",
    "sass": "^1.97.2",
    "screenfull": "^6.0.2",
    "sharp": "^0.34.5",
    "smpte-timecode": "^1.3.6",
    "sweetalert2": "^11.26.17",
    "sweetalert2-react-content": "^5.1.1",
    "tiny-invariant": "^1.3.3",
    "ts-morph": "^27.0.2",
    "type-fest": "^5.3.1",
    "typescript": "~5.9.3",
    "use-debounce": "^5.2.1",
    "vite": "^7.3.5",
    "vitest": "^4.1.4",
    "yargs": "^18.2.0"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@octokit/core": "7.0.6",
    "cue-parser": "^0.3.0",
    "electron-store": "5.1.1",
    "electron-unhandled": "^5.0.0",
    "electron-updater": "6.8.9",
    "execa": "^9.6.1",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "file-type": "^21.3.1",
    "i18next": "^25.7.3",
    "i18next-fs-backend": "^2.6.6",
    "json5": "^2.2.3",
    "lodash.debounce": "^4.0.8",
    "mime-types": "^3.0.2",
    "mitt": "patch:mitt@npm%3A3.0.1#~/.yarn/patches/mitt-npm-3.0.1-ce290ffa77.patch",
    "morgan": "^1.10.1",
    "semver": "^7.7.3",
    "winston": "^3.19.0",
    "yargs-parser": "^22.0.0",
    "zod": "^4.3.5"
  },
  "build": {
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "files": [
      "out/**/*",
      "LICENSE",
      "!**/*.map",
      "!out/licenses.txt",
      "!node_modules/electron/**/*",
      "!node_modules/typescript/**/*",
      "!node_modules/electron-devtools-installer/**/*",
      "!node_modules/@electron/get/**/*",
      "!node_modules/extract-zip/**/*",
      "!node_modules/@electron-internal/**/*",
      "!node_modules/undici/**/*",
      "!node_modules/node-gyp/**/*",
      "!node_modules/npmlog/**/*",
      "!node_modules/zod/**/*"
    ],
    "afterPack": "./script/afterPack.ts",
    "asar": {
      "smartUnpack": false
    },
    "appId": "com.clippress.app",
    "electronLanguages": [
      "en-US"
    ],
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "locales",
        "to": "locales"
      },
      {
        "from": "out/licenses.txt",
        "to": "licenses.txt"
      }
    ],
    "win": {
      "target": [
        {
          "arch": "x64",
          "target": "nsis"
        },
        {
          "arch": "x64",
          "target": "portable"
        }
      ],
      "artifactName": "ClipPress-Windows-x64.${ext}",
      "extraResources": [
        {
          "from": "ffmpeg/win32-${arch}/lib",
          "to": "."
        }
      ],
      "icon": "icon-build/app.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "adillpickles",
      "repo": "ClipPress"
    },
    "nsis": {
      "artifactName": "ClipPress-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "deleteAppDataOnUninstall": false,
      "uninstallUrlUpdateInfo": "https://github.com/adillpickles/ClipPress/releases",
      "include": "script/installer.nsh",
      "uninstallDisplayName": "${productName}"
    }
  },
  "resolutions": {
    "icon-gen/sharp": "^0.34.5"
  },
  "packageManager": "yarn@4.11.0"
}
